// Number of stable processes.
// There will be N stable processes, 1 additional concrete process, and one Other representing the rest of the network
const int N = 2;
const int MAX_HB = 8;
const int MAX_SEQ = 10;
const int MAX_NUMENTRIES = 4;
const int TH_HB = 3;
const int MAX_COUNT = 30;

int[0,MAX_COUNT] counter = 0;
// Processes are numbered 1...N; 0 is a dummy process
// All processes 1..N are initialized in an arbitrary state where they are already converged:
//    myroot = 1 /\ myseq[1] = 2 /\ myseq[2..N] <= 1
//    and their clocks take arbitrary values
//
typedef int[0,N+2] pid_t;  // N+2 means bottom
typedef int[1,N] stable_pid_t;
typedef int[1,N+1] concrete_pid_t;

// Biztonságos explicit méretezés a Theta számára
chan wakeup[N+3];
chan receive[N+3];

int[0,N+2] msg_root;
int[0,MAX_SEQ] msg_seq;
int[0,MAX_SEQ] myseq[N+2];

// whether we are ready to "go"
bool ready = false;
broadcast chan go;

process Timer(const int i) {
    clock x;
    state
        q { x<=4 },
        q0 { x<=4 };
    init
        q0;
    trans
        q0 -> q0 { assign x=0; },
        q0 -> q { sync go?; },
        q -> q { guard x>=3 && x<= 4; sync wakeup[i]!; assign x=0; };
}

process StableProcess(const int id) {
    int[0,MAX_HB] hb = 0;
    int[0,N+1] myroot = N+1;
    int[0,MAX_NUMENTRIES] numentries = 0;
    state
        idle,
        send_left,
        send_right,
        normalize,
        L0;
    commit
        send_left,
        send_right,
        normalize;
    init
        L0;
    trans
        L0 -> idle { sync go?; assign myroot=1, myseq[id] = 1; },
        L0 -> idle { sync go?; assign myroot=1, myseq[id] = 0; },
        L0 -> idle { sync go?; assign myroot=1, myseq[id] = 2; },
        normalize -> idle { guard myseq[1] == 0 || myseq[2] == 0 || myseq[3] == 0; },
        idle -> idle {
            guard !((msg_root > myroot) || (myroot == id && hb < TH_HB) || (msg_root == myroot && msg_seq <= myseq[id]));
            sync receive[id]?;
            assign hb = (msg_root < id)? 0 : hb, myroot = (msg_root < myroot)? msg_root : myroot, numentries = (numentries + 1 <= MAX_NUMENTRIES)? numentries + 1 : MAX_NUMENTRIES, myseq[id] = msg_seq;
        },
        normalize -> idle { guard myseq[1] >= 1 && myseq[2] >= 1 && myseq[3] >=1; assign myseq[1] = myseq[1] - 1, myseq[2] = myseq[2] - 1, myseq[3] = myseq[3] - 1; },
        send_right -> normalize { sync receive[id+1]!; },
        idle -> idle {
            guard ((msg_root > myroot) || (myroot == id && hb < TH_HB) || (msg_root == myroot && msg_seq <= myseq[id]));
            sync receive[id]?;
        },
        send_left -> send_right { sync receive[id-1]!; },
        idle -> idle {
            guard myroot != id && numentries < MAX_NUMENTRIES;
            sync wakeup[id]?;
            assign hb=(hb+1<= MAX_HB)? hb+1 : MAX_HB, myroot = (hb >= MAX_HB)? id : myroot, counter = (id == 1 && counter < MAX_COUNT)? counter+1 : counter;
        },
        idle -> send_left {
            guard myroot == id || numentries >= MAX_NUMENTRIES;
            sync wakeup[id]?;
            assign hb=(hb+1<= MAX_HB)? hb+1 : MAX_HB, myroot = (hb >= MAX_HB)? id : myroot, myseq[id] = (myroot == id)? ((myseq[id]+1 <= MAX_SEQ)? myseq[id]+1 : MAX_SEQ): myseq[id], msg_root = myroot, msg_seq = myseq[id], counter = (id == 1 && counter < MAX_COUNT)? counter+1 : counter;
        };
}

process LastProcess(const int id) {
    int[0,MAX_HB] hb = 0;
    int[0,N+1] myroot = N+1;
    int[0,MAX_NUMENTRIES] numentries = 0;
    state
        idle,
        send_left,
        send_right,
        normalize,
        L0,
        L1,
        L2,
        L3;
    commit
        send_left,
        send_right,
        normalize;
    init
        L0;
    trans
        L0 -> L1 { assign numentries=4; },
        L0 -> L1 { assign numentries=3; },
        L0 -> L1 { assign myroot=2; },
        L0 -> L1 { assign myroot=1; },
        L1 -> L2 { assign numentries=4; },
        L1 -> L2 { assign numentries=3; },
        L1 -> L2 { assign numentries=2; },
        L1 -> L2 { assign numentries=1; },
        L1 -> L2 { assign numentries=0; },
        L2 -> L3 { assign hb=8,ready=true; },
        L2 -> L3 { assign hb=5,ready=true; },
        L2 -> L3 { assign hb=7,ready=true; },
        L2 -> L3 { assign hb=6,ready=true; },
        L2 -> L3 { assign hb=4,ready=true; },
        L2 -> L3 { assign hb=3; },
        L2 -> L3 { assign hb=2,ready=true; },
        L2 -> L3 { assign hb=1,ready=true; },
        L2 -> L3 { assign hb=0,ready=true; },
        L3 -> idle { sync go?; assign myseq[N+1]=3; },
        L3 -> idle { sync go?; assign myseq[N+1]=2; },
        L3 -> idle { sync go?; assign myseq[N+1]=1; },
        L3 -> idle { sync go?; assign myseq[N+1]=0; },
        normalize -> idle { guard myseq[1] == 0 || myseq[2] == 0 || myseq[3] == 0; },
        idle -> idle {
            guard !((msg_root > myroot) || (myroot == id && hb < TH_HB) || (msg_root == myroot && msg_seq <= myseq[id]));
            sync receive[id]?;
            assign hb = (msg_root < id)? 0 : hb, myroot = (msg_root < myroot)? msg_root : myroot, numentries = (numentries + 1 <= MAX_NUMENTRIES)? numentries + 1 : MAX_NUMENTRIES, myseq[id] = msg_seq;
        },
        normalize -> idle { guard myseq[1] >= 1 && myseq[2] >= 1 && myseq[3] >=1; assign myseq[1] = myseq[1] - 1, myseq[2] = myseq[2] - 1, myseq[3] = myseq[3] - 1; },
        send_right -> normalize { },
        idle -> idle {
            guard ((msg_root > myroot) || (myroot == id && hb < TH_HB) || (msg_root == myroot && msg_seq <= myseq[id]));
            sync receive[id]?;
        },
        send_left -> send_right { sync receive[id-1]!; },
        idle -> idle {
            guard myroot != id && numentries < MAX_NUMENTRIES;
            sync wakeup[id]?;
            assign hb=(hb+1<= MAX_HB)? hb+1 : MAX_HB, myroot = (hb >= MAX_HB)? id : myroot, counter = (id == 1 && counter < MAX_COUNT)? counter+1 : counter;
        },
        idle -> send_left {
            guard myroot == id || numentries >= MAX_NUMENTRIES;
            sync wakeup[id]?;
            assign hb=(hb+1<= MAX_HB)? hb+1 : MAX_HB, myroot = (hb >= MAX_HB)? id : myroot, myseq[id] = (myroot == id)? ((myseq[id]+1 <= MAX_SEQ)? myseq[id]+1 : MAX_SEQ): myseq[id], msg_root = myroot, msg_seq = myseq[id], counter = (id == 1 && counter < MAX_COUNT)? counter+1 : counter;
        };
}

process Dummy() {
    state
        L0,
        L1;
    init
        L1;
    trans
        L1 -> L0 { guard ready; sync go!; },
        L0 -> L0 { sync receive[0]?; };
}

process Others() {
    state
        L0,
        L1,
        L2;
    commit
        L1,
        L2;
    init
        L0;
    trans
        L2 -> L0 { sync receive[1]!; },
        L2 -> L0 { sync receive[2]!; },
        L2 -> L0 { sync receive[3]!; },
        L2 -> L0 { },
        L1 -> L2 { assign msg_seq=8; },
        L1 -> L2 { assign msg_seq=7; },
        L1 -> L2 { assign msg_seq=0; },
        L1 -> L2 { assign msg_seq=6; },
        L1 -> L2 { assign msg_seq=5; },
        L1 -> L2 { assign msg_seq=4; },
        L1 -> L2 { assign msg_seq=3; },
        L1 -> L2 { assign msg_seq=2; },
        L1 -> L2 { assign msg_seq=1; },
        L0 -> L1 { assign msg_root=4; },
        L0 -> L1 { assign msg_root=3; },
        L0 -> L1 { assign msg_root=2; };
}

t1 = Timer(1);
t2 = Timer(2);
t3 = Timer(3);
last = LastProcess(N+1);
d = Dummy();
sp1 = StableProcess(1);
sp2 = StableProcess(2);

system sp1, sp2, Others, last, t1, t2, t3, d;