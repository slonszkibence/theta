            cond_0 = (obsx_0_0_6 || obsx_1 || obsx_2),
            cond_1 = (obsy_0_0_6 || obsy_1),
            cond_2 = (obsy_0_0_6 || obsx_1);
    };
}

process Scheduler() {
state
    wait,
    p0,
    p1,
    idle,
    p0_ { x<=comp_u_0 },
    p1_ { x<=comp_u_1 },
    idle_ { x<=5 },
    L0 { x<=comp_u_2 };
commit
    p0,
    p1,
    idle;
urgent
    wait;
init
    wait;
trans
    L0 -> wait { },
    wait -> L0 { guard !is_ready_0 && !is_ready_1 && is_ready_2; sync step!; assign x=0, is_ready_2=false; },
    idle_ -> wait { assign x=0; },
    idle -> idle_ { sync step!; },
    p1_ -> wait { assign x=0; },
    p1 -> p1_ { sync step!; },
    p0_ -> wait { assign x=0; },
    p0 -> p0_ { sync step!; },
    p1 -> wait { sync step!; },
    p0 -> wait { },
    wait -> idle { guard !is_ready_0 && !is_ready_1 && !is_ready_2; assign x=0; },
    wait -> p1 { guard !is_ready_0 && is_ready_1; assign x=0, is_ready_1=false; },
    wait -> p0 { guard is_ready_0; assign x=0, is_ready_0=false; };
}

process P(const int i, const int my_dead, const int my_inter) {
clock y;
state q, missed;
init q;
trans
    q -> missed { guard y > my_dead && (i==0 ? is_ready_0 : (i==1 ? is_ready_1 : is_ready_2)); },
    q -> q {
        guard y >= my_inter && (i==0 ? cond_0 : (i==1 ? cond_1 : cond_2));
        sync step!;
        assign y=0,
               is_ready_0 = (i==0 ? true : is_ready_0),
               is_ready_1 = (i==1 ? true : is_ready_1),
               is_ready_2 = (i==2 ? true : is_ready_2);
    };
}

p0 = P(0, 20, 15);
p1 = P(1, 20, 20);
p2 = P(2, 40, 25);
mysched = Scheduler();
internals = Internals();

system p0, p1, p2, mysched, internals;