process Scheduler() {
    state
        L0, L1, error, L2, L3, L4, L5, L6, L7, L8, L9, L10, L11, L12, L13, L14, L15, L16, L17, L18;
    commit
        L1, L2, L3, L4, L5, L6, L7, L8, L9, L10, L11, L12, L13, L14, L15, L16, L17, L18;
    init
        L2;
    trans
        L18 -> L0 {
            guard cnt < 20;
            assign
                a44 = benchbad_out && benchn29,
                a46 = benchstate_g0_g_out && benchn29,
