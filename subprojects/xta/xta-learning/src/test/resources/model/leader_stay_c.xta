                a246 = !controllable_c1_g && !controllable_c0_g,
                a248 = !a246 && controllable_c5_g,
                a250 = !a248 && !in1_g,
                a252 = a250 && !in2_g,
                a254 = !a252 && !a244,
                a256 = !a254 && !in0_g,
                a258 = a256 && a230,
                a260 = a258 && a214,
                a262 = a260 && a198,
                a264 = !a262 && a46,
                a266 = a262 && !a46,
                a268 = !a266 && !a264,
                a270 = a264 && a48,
                a272 = !a264 && !a48,
                a274 = !a272 && !a270,
                a276 = a270 && a52,
                a278 = !a270 && !a52,
                a280 = !a278 && !a276,
                a282 = a276 && a56,
                a284 = !a276 && !a56,
                a286 = !a284 && !a282,
                a288 = a282 && a60,
                a290 = !a282 && !a60,
                a292 = !a290 && !a288,
                a294 = a288 && !a64,
                a296 = !a288 && a64,
                a298 = !a296 && !a294,
                benchn29 = true,
                benchbad_out = !(!(benchbad_out && benchn29) && !controllable_s),
                benchstate_g0_g_out = a268,
                benchstate_g1_g_out = a274,
                benchstate_g2_g_out = a280,
                benchstate_g3_g_out = a286,
                benchstate_g4_g_out = a292,
                benchstate_g5_g_out = !a298,
                cnt = cnt + 1;
        },
        L18 -> L0 {
            guard cnt >= 20;
            assign
                a44 = benchbad_out && benchn29,
                a46 = benchstate_g0_g_out && benchn29,
                a48 = benchstate_g1_g_out && benchn29,
                a50 = a48 && a46,
                a52 = benchstate_g2_g_out && benchn29,
                a54 = a52 && a50,
                a56 = benchstate_g3_g_out && benchn29,
                a58 = a56 && a54,
                a60 = benchstate_g4_g_out && benchn29,
                a62 = a60 && a58,
                a64 = benchstate_g5_g_out && benchn29,
                a66 = a64 && a62,
                a68 = a66 && a44,
                a70 = !a44 && !controllable_s,
                a72 = !in0_g && !controllable_c5_g,
                a74 = !a72 && controllable_c4_g,
                a76 = in0_g && controllable_c3_g,
                a78 = in0_g && controllable_c2_g,
                a80 = in2_g && controllable_c0_g,
                a82 = in1_g && controllable_c0_g,
                a84 = in0_g && controllable_c1_g,
                a86 = a84 && a82,
                a88 = in1_g && controllable_c1_g,
                a90 = a88 && !a86,
                a92 = !a90 && !a80,
                a94 = a88 && a80,
                a96 = a94 && !in0_g,
                a98 = !a96 && !a92,
                a100 = a98 && a78,
                a102 = in1_g && controllable_c2_g,
                a104 = in3_g && controllable_c0_g,
                a106 = !a94 && !a86,
                a108 = in2_g && controllable_c1_g,
                a110 = !a108 && a106,
                a112 = !a110 && !a94,
                a114 = a112 && a104,
                a116 = !a112 && !a104,
                a118 = !a116 && !a114,
                a120 = a118 && a102,
                a122 = !a118 && !a102,
                a124 = !a122 && !a120,
                a126 = a124 && a100,
                a128 = !a124 && !a100,
                a130 = !a128 && !a126,
                a132 = a130 && a76,
                a134 = in1_g && controllable_c3_g,
                a136 = in4_g && controllable_c0_g,
                a138 = in3_g && controllable_c1_g,
                a140 = a138 && !a136,
                a142 = !a138 && a136,
                a144 = !a142 && !a140,
                a146 = !a110 && a104,
                a148 = !a146 && !a94,
                a150 = a148 && a144,
                a152 = !a148 && !a144,
                a154 = !a152 && !a150,
                a156 = !a122 && a100,
                a158 = !a156 && !a120,
                a160 = in2_g && controllable_c2_g,
                a162 = a160 && !a158,
                a164 = !a160 && a158,
                a166 = !a164 && !a162,
                a168 = a166 && a154,
                a170 = !a166 && !a154,
                a172 = !a170 && !a168,
                a174 = a172 && a134,
                a176 = !a172 && !a134,
                a178 = !a176 && !a174,
                a180 = a178 && a132,
                a182 = !a178 && !a132,
                a184 = !a182 && !a180,
                a186 = a184 && !controllable_c5_g,
                a188 = a186 && !a74,
                a190 = !a186 && a74,
                a192 = !a190 && !a188,
                a194 = !a192 && !in5_g,
                a196 = a192 && in5_g,
                a198 = !a196 && !a194,
                a200 = controllable_c5_g && controllable_c3_g,
                a202 = !a130 && !a76,
                a204 = !a202 && !a132,
                a206 = a204 && !controllable_c5_g,
                a208 = !a206 && !a200,
                a210 = !a208 && !in4_g,
                a212 = a208 && in4_g,
                a214 = !a212 && !a210,
                a216 = controllable_c5_g && controllable_c2_g,
                a218 = !a98 && !a78,
                a220 = !a218 && !a100,
                a222 = a220 && !controllable_c5_g,
                a224 = !a222 && !a216,
                a226 = !a224 && !in3_g,
                a228 = a224 && in3_g,
                a230 = !a228 && !a226,
                a232 = !in2_g && !controllable_c1_g,
                a234 = a232 && a82,
                a236 = !in1_g && !controllable_c0_g,
                a238 = !a236 && !a82,
                a240 = !a238 && a108,
                a242 = !a240 && !a234,
                a244 = !a242 && controllable_c5_g,
                a246 = !controllable_c1_g && !controllable_c0_g,
                a248 = !a246 && controllable_c5_g,
                a250 = !a248 && !in1_g,
                a252 = a250 && !in2_g,
                a254 = !a252 && !a244,
                a256 = !a254 && !in0_g,
                a258 = a256 && a230,
                a260 = a258 && a214,
                a262 = a260 && a198,
                a264 = !a262 && a46,
                a266 = a262 && !a46,
                a268 = !a266 && !a264,
                a270 = a264 && a48,
                a272 = !a264 && !a48,
                a274 = !a272 && !a270,
                a276 = a270 && a52,
                a278 = !a270 && !a52,
                a280 = !a278 && !a276,
                a282 = a276 && a56,
                a284 = !a276 && !a56,
                a286 = !a284 && !a282,
                a288 = a282 && a60,
                a290 = !a282 && !a60,
                a292 = !a290 && !a288,
                a294 = a288 && !a64,
                a296 = !a288 && a64,
                a298 = !a296 && !a294,
                benchn29 = true,
                benchbad_out = !(!(benchbad_out && benchn29) && !controllable_s),
                benchstate_g0_g_out = a268,
                benchstate_g1_g_out = a274,
                benchstate_g2_g_out = a280,
                benchstate_g3_g_out = a286,
                benchstate_g4_g_out = a292,
                benchstate_g5_g_out = !a298;
        },

        L17 -> L18 { assign controllable_s=false; },
        L17 -> L18 { assign controllable_s=true; },
        L16 -> L17 { assign in5_g=true; },
        L15 -> L16 { assign in4_g=true; },
        L14 -> L15 { assign in3_g=true; },
        L13 -> L14 { assign in2_g=true; },
        L12 -> L13 { assign in1_g=true; },
        L11 -> L12 { assign in0_g=true; },
        L10 -> L11 { assign controllable_c5_g=false; },
        L9 -> L10 { assign controllable_c4_g=false; },
        L8 -> L9 { assign controllable_c3_g=true; },
        L7 -> L8 { assign controllable_c2_g=true; },
        L6 -> L7 { assign controllable_c1_g=true; },
        L16 -> L17 { assign in5_g=false; },
        L15 -> L16 { assign in4_g=false; },
        L14 -> L15 { assign in3_g=false; },
        L13 -> L14 { assign in2_g=false; },
        L12 -> L13 { assign in1_g=false; },
        L11 -> L12 { assign in0_g=false; },
        L10 -> L11 { assign controllable_c5_g=true; },
        L9 -> L10 { assign controllable_c4_g=true; },
        L8 -> L9 { assign controllable_c3_g=false; },
        L7 -> L8 { assign controllable_c2_g=false; },
        L6 -> L7 { assign controllable_c1_g=false; },
        L1 -> L6 { assign controllable_c0_g=true; },
        L1 -> L6 { assign controllable_c0_g=false; },
        L5 -> L0 { },
        L4 -> L5 { guard id[0]!=2 && id[1] != 2; assign id[2] =2; },
        L4 -> L5 { guard id[0]!=0 && id[1] != 0; assign id[2]=0; },
        L4 -> L5 { guard id[0]!=1&&id[1]!=1; assign id[2]=1; },
        L3 -> L4 { guard id[0]!=2; assign id[1]=2; },
        L3 -> L4 { guard id[0]!=1; assign id[1]=1; },
        L3 -> L4 { guard id[0]!=0; assign id[1]=0; },
        L2 -> L3 { assign id[0]=2; },
        L2 -> L3 { assign id[0]=1; },
        L2 -> L3 { assign id[0]=0; },
        L0 -> L0 { sync wakeup[2]!; },
        L0 -> L0 { sync wakeup[1]!; },
        L0 -> error { guard (leader[0] != 0 || leader[1] != 0 || leader[2] != 0) && cnt >= 15; },
        L0 -> L1 { sync wakeup[0]!; },
        L0 -> L0 { guard crash_cnt<3 && a68; sync crash[0]!; assign crash_cnt = crash_cnt + 1, cnt=0; };
}

process Process0(const int i) {
    clock x;
    int[0,4] hb;
    pid_t prev;

    state
        ok { x<=4 },
        sending,
        crashed { x<=12 },
        initialize;
    commit
        sending,
        initialize;
    init
        initialize;
    trans
        // --- INLINED receive() függvény: négy külön ág lefedve ---
        ok -> ok { guard msg < id[i] && sender < id[i]; sync broadchan?; assign prev=leader[i], leader[i]=msg, hb=0; },
        ok -> ok { guard msg < id[i] && sender >= id[i]; sync broadchan?; assign prev=leader[i], leader[i]=msg; },
        ok -> ok { guard msg >= id[i] && sender < id[i]; sync broadchan?; assign hb=0; },
        ok -> ok { guard msg >= id[i] && sender >= id[i]; sync broadchan?; },
        // --- --- --- ---

        initialize -> ok { assign leader[i]=N; },
        crashed -> crashed { sync broadchan?; },
        crashed -> crashed { assign leader[i]=2; },
        crashed -> crashed { assign hb=0; },
        crashed -> crashed { assign hb=1; },
        crashed -> crashed { assign leader[i]=1; },
        crashed -> crashed { assign leader[i]=0; },
        crashed -> crashed { assign hb=4; },
        crashed -> crashed { assign hb=3; },
        crashed -> crashed { assign hb=2; },
        crashed -> ok { guard x<=12; sync wakeup[i]?; assign x=0; },
        ok -> crashed { sync crash[i]?; assign x=0; },
        sending -> ok { sync broadchan!; },
        ok -> sending { guard hb==4 && x == 4; sync wakeup[i]?; assign prev=leader[i], leader[i]=id[i], msg=id[i],sender=id[i], hb=0; },
        ok -> sending { guard hb<4 && x==4; sync wakeup[i]?; assign hb=hb+1, msg=leader[i],sender=id[i],x=0; };
}

process Process1(const int i) {
    clock x;
    int[0,4] hb;
    pid_t prev;

    state
        ok { x<=1 },
        sending,
        crashed { x<=4 },
        initialize;
    commit
        sending,
        initialize;
    init
        initialize;
    trans
        // --- INLINED receive() függvény: négy külön ág lefedve ---
        ok -> ok { guard msg < id[i] && sender < id[i]; sync broadchan?; assign prev=leader[i], leader[i]=msg, hb=0; },
        ok -> ok { guard msg < id[i] && sender >= id[i]; sync broadchan?; assign prev=leader[i], leader[i]=msg; },
        ok -> ok { guard msg >= id[i] && sender < id[i]; sync broadchan?; assign hb=0; },
        ok -> ok { guard msg >= id[i] && sender >= id[i]; sync broadchan?; },
        // --- --- --- ---

        initialize -> ok { assign leader[i]=N; },
        crashed -> crashed { sync broadchan?; },
        crashed -> crashed { assign leader[i]=2; },
        crashed -> crashed { assign hb=0; },
        crashed -> crashed { assign hb=1; },
        crashed -> crashed { assign leader[i]=1; },
        crashed -> crashed { assign leader[i]=0; },
        crashed -> crashed { assign hb=4; },
        crashed -> crashed { assign hb=3; },
        crashed -> crashed { assign hb=2; },
        crashed -> ok { guard x==4; sync wakeup[i]?; assign x=0; },
        ok -> crashed { sync crash[i]?; assign x=0; },
        sending -> ok { sync broadchan!; },
        ok -> sending { guard hb==4 && x == 1; sync wakeup[i]?; assign prev=leader[i], leader[i]=id[i], msg=id[i],sender=id[i], hb=0; },
        ok -> sending { guard hb<4 && x==1; sync wakeup[i]?; assign hb=hb+1, msg=leader[i],sender=id[i],x=0; };
}

process Process2(const int i) {
    clock x;
    int[0,4] hb;
    pid_t prev;

    state
        ok { x<=3 },
        sending,
        crashed { x<=3 },
        initialize;
    commit
        sending,
        initialize;
    init
        initialize;
    trans
        // --- INLINED receive() függvény: négy külön ág lefedve ---
        ok -> ok { guard msg < id[i] && sender < id[i]; sync broadchan?; assign prev=leader[i], leader[i]=msg, hb=0; },
        ok -> ok { guard msg < id[i] && sender >= id[i]; sync broadchan?; assign prev=leader[i], leader[i]=msg; },
        ok -> ok { guard msg >= id[i] && sender < id[i]; sync broadchan?; assign hb=0; },
        ok -> ok { guard msg >= id[i] && sender >= id[i]; sync broadchan?; },
        // --- --- --- ---

        initialize -> ok { assign leader[i]=N; },
        crashed -> crashed { sync broadchan?; },
        crashed -> crashed { assign leader[i]=2; },
        crashed -> crashed { assign hb=0; },
        crashed -> crashed { assign hb=1; },
        crashed -> crashed { assign leader[i]=1; },
        crashed -> crashed { assign leader[i]=0; },
        crashed -> crashed { assign hb=4; },
        crashed -> crashed { assign hb=3; },
        crashed -> crashed { assign hb=2; },
        crashed -> ok { guard x==3; sync wakeup[i]?; assign x=0; },
        ok -> crashed { sync crash[i]?; assign x=0; },
        sending -> ok { sync broadchan!; },
        ok -> sending { guard hb==4 && x == 3; sync wakeup[i]?; assign prev=leader[i], leader[i]=id[i], msg=id[i],sender=id[i], hb=0; },
        ok -> sending { guard hb<4 && x==3; sync wakeup[i]?; assign hb=hb+1, msg=leader[i],sender=id[i],x=0; };
}

p0 = Process0(0);
p1 = Process1(1);
p2 = Process2(2);
s = Scheduler();
system p0, p1, p2, s;